{
  "name": "moxie-prediction-perps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev:web": "pnpm --filter @moxie/web dev",
    "build:web": "pnpm --filter @moxie/web build",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:adversarial",
    "test:unit": "node --test packages/provider-adapter/test/*.test.ts packages/market-catalog/test/*.test.ts packages/config/test/*.test.ts packages/sdk/test/*.test.ts services/oracle-reporter/test/*.test.ts services/resolution-reporter/test/*.test.ts services/keeper/test/*.test.ts services/indexer/test/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:adversarial": "node --test tests/adversarial/*.test.ts",
    "deploy:local": "node scripts/deploy-local.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "smoke:jupiter": "node --env-file=.env --experimental-strip-types scripts/smoke-jupiter.mjs",
    "deploy:local:live": "pnpm run smoke:jupiter && node scripts/deploy-local.mjs --live",
    "deploy:devnet": "node --env-file=.env scripts/deploy-local.mjs --devnet",
    "deploy:devnet:live": "pnpm run smoke:jupiter && node --env-file=.env scripts/deploy-local.mjs --devnet --live",
    "verify:devnet": "node scripts/verify-local.mjs deployments/devnet.local.json",
    "seed:demo": "node scripts/not-implemented.mjs seed:demo 'Phase 12: demo seeding'",
    "demo:liquidation": "node scripts/not-implemented.mjs demo:liquidation 'Phase 11: liquidation scenario'",
    "demo:resolution": "node scripts/not-implemented.mjs demo:resolution 'Phase 11: resolution scenario'",
    "proof:export": "node scripts/not-implemented.mjs proof:export 'Phase 15: proof manifest'",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "config:market-group": "node scripts/print-market-group.mjs",
    "db:migrate": "node --experimental-strip-types packages/db/migrate.ts",`n    "indexer:start": "node --experimental-strip-types services/indexer/src/server.ts",
    "keeper:prices": "node scripts/keeper-price-feed.mjs",
    "keeper:prices:once": "node scripts/keeper-price-feed.mjs --once"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@solana/web3.js": "^1.99.0",
    "drizzle-orm": "^0.45.3"
  }
}
